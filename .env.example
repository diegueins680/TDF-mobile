EXPO_PUBLIC_API_BASE=https://tdf-hq.fly.dev
EXPO_PUBLIC_UPLOAD_URL=https://tdf-hq.fly.dev/drive/upload
EXPO_PUBLIC_TZ=America/Guayaquil

# Optional if the Expo project is not linked locally yet.
EAS_PROJECT_ID=

# Required to enable Google Sign-In in native builds.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Native plugin wiring accepts either alias; prefer GOOGLE_IOS_URL_SCHEME when available.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
GOOGLE_IOS_URL_SCHEME=

# Development only. Do not ship this in preview or production builds.
# EXPO_PUBLIC_API_TOKEN=

# Analytics (PostHog). Leave EXPO_PUBLIC_POSTHOG_KEY empty in dev to disable.
# Default host is the EU cloud. Override for self-hosted / US cloud.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Stripe native PaymentSheet. Use a publishable key only; never put secret keys in the app.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional. Required only when enabling Apple Pay through Stripe.
EXPO_PUBLIC_STRIPE_MERCHANT_IDENTIFIER=
STRIPE_MERCHANT_IDENTIFIER=
