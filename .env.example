EXPO_PUBLIC_API_BASE=https://tdf-hq.fly.dev
EXPO_PUBLIC_UPLOAD_URL=https://tdf-hq.fly.dev/drive/upload
EXPO_PUBLIC_TZ=America/Guayaquil

# Optional if the Expo project is not linked locally yet.
EAS_PROJECT_ID=

# Required to enable Google Sign-In in native builds.
# Put real values in tdf-mobile/.env.local or exported shell env for local proof runs.
# GOOGLE_IOS_URL_SCHEME must exactly match the reversed EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID prefix.
# Example:
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=1234567890-abcdef.apps.googleusercontent.com
# GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.1234567890-abcdef
# Do not use EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME here; native plugin setup ignores that alias.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=

# Development only. Do not ship this in preview or production builds.
# EXPO_PUBLIC_API_TOKEN=
