{
  "cli": {
    "version": ">= 16.16.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://the-dream-factory.koyeb.app",
        "EXPO_PUBLIC_UPLOAD_URL": "https://the-dream-factory.koyeb.app/drive/upload"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://the-dream-factory.koyeb.app",
        "EXPO_PUBLIC_UPLOAD_URL": "https://the-dream-factory.koyeb.app/drive/upload"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
